NODE_ENV=development
APP_NAME=Just Flow SSL Monitor
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://sslmonitor:password@localhost:5432/sslmonitor
SESSION_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-this-password
INITIAL_ADMIN_NAME=Administrator
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEFAULT_ALERT_RECIPIENTS=
MONITORING_TIMEZONE=America/New_York
DEFAULT_ALERT_THRESHOLDS=30,14,7,3,1,0
TLS_TIMEOUT_MS=10000
HTTP_TIMEOUT_MS=15000
MONITOR_CONCURRENCY=5
HISTORY_RETENTION_DAYS=365
ALLOW_PRIVATE_ORIGIN_HOSTS=false
ALLOWED_TLS_PORTS=443,8443
DAILY_MONITORING_ENABLED=true
